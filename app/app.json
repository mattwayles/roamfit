{
  "expo": {
    "name": "Wanderlift",
    "slug": "wanderlift",
    "version": "1.0.0",
    "scheme": "wanderlift",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0E13",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0E13"
    },
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "com.mattwayles.wanderlift",
      "appleTeamId": "XRUA6GUDR8",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "NSLocationWhenInUseUsageDescription": "Wanderlift uses your location once, at the end of a workout, to pin the city and country on your Passport. It's never tracked in the background.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": ["iCloud.com.mattwayles.wanderlift"],
        "com.apple.developer.icloud-services": ["CloudDocuments"],
        "com.apple.developer.ubiquity-container-identifiers": ["iCloud.com.mattwayles.wanderlift"]
      }
    },
    "plugins": [
      "expo-dev-client",
      "expo-audio",
      "expo-notifications",
      "expo-location",
      "expo-secure-store",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Wanderlift does not read any Health data — this permission is unused.",
          "NSHealthUpdateUsageDescription": "Wanderlift writes each completed workout to Health. It never reads your health data.",
          "background": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9c5d70b8-0df6-4a91-b8a5-d527135b3a66"
      }
    },
    "owner": "mattwayles"
  }
}
