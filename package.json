{
  "name": "roamfit",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "app",
    "packages/engine",
    "packages/data",
    "packages/store",
    "functions"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "check:engine-purity": "node tools/check-engine-purity.js",
    "validate:library": "npm run validate:library --workspace packages/data",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:engine-purity",
    "ios": "npm run ios --workspace app",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.11.0",
    "patch-package": "^8.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
